# Bu fayl namuna. Haqiqiy qiymatlar `apps/api/.env`ga yoziladi va repoga kirmaydi.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Qo'shimcha ruxsat etilgan origin'lar, vergul bilan (staging, ikkinchi domen).
#
# Telefondan LAN orqali kirish uchun bu KERAK EMAS. Brauzer web bilan bir
# xil origin'ga uradi va `apps/web` dagi rewrite uni shu yerga proksilaydi;
# ro'yxatga tushmagan origin rad etilmaydi, javobga shunchaki CORS
# sarlavhalari qo'shilmaydi (`main.ts` ga qarang).
WEB_ORIGIN_EXTRA=

# Lokal PostgreSQL (§0.3 — development'da Docker ishlatilmaydi).
#
# Bu manzil FAQAT CLI va vositalar uchun: `prisma migrate dev`, `studio`,
# `seed` (`prisma.config.ts` shuni o'qiydi). Development'da u superuser
# bo'lib qoladi, chunki `migrate dev` shadow-baza yaratadi, `hisobai_migrate`
# esa ataylab `NOCREATEDB` (§21.16). Ishlab chiqarishda deploy qadami uni
# `hisobai_migrate` ga yo'naltiradi.
#
# ILOVA ISHLASH VAQTIDA BU MANZILDAN FOYDALANMAYDI — pastdagi
# `DATABASE_URL_APP` ga qarang.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hisob_ai?schema=public"

# §21.16 — ilova ishlash vaqtida FAQAT shu manzil orqali ulanadi.
# `hisobai_app` roli: NOSUPERUSER, NOBYPASSRLS, jadval darajasida CRUD,
# `audit_logs` da esa faqat INSERT+SELECT.
#
# Rol 20260813150000_rls_tenant_isolation_and_roles migratsiyasida PAROLSIZ
# yaratiladi. Ishga tushirishdan oldin operator parol qo'yadi:
#
#   psql -U postgres -d hisob_ai -c "ALTER ROLE hisobai_app WITH PASSWORD '...'"
#
# va shu manzilni to'ldiradi. Zaxira (fallback) YO'Q: bo'sh bo'lsa ilova
# ishga tushmaydi. Sabab — `DATABASE_URL` ga jimgina qaytish superuser
# ostida ishlashni anglatardi, superuser esa `FORCE ROW LEVEL SECURITY` ni
# ham chetlab o'tadi, ya'ni §14.4 dagi ikkinchi himoya qatlami mavjud
# bo'lmasdan turib hamma narsa ishlayotgandek ko'rinardi.
# Namuna (parolni qo'yib, izohni oching):
#   postgresql://hisobai_app:PAROL@localhost:5432/hisob_ai?schema=public
# Qiymat ATAYLAB bo'sh: nusxa ko'chirilgan `.env` tayyor manzil bilan
# kelsa, u ikkala tekshiruvdan ham o'tib ketardi va nosozlik keyinroq,
# `password authentication failed for user "hisobai_app"` degan tushunarsiz
# ko'rinishda chiqardi — yuqoridagi aniq xabarning butun ma'nosi shunda.
DATABASE_URL_APP=

# `prisma migrate deploy` uchun (ishlab chiqarish). Development'da kerak
# emas — yuqoridagi izohga qarang.
DATABASE_URL_MIGRATE=

# Izolyatsiya integratsiya testlari uchun ALOHIDA baza (§12 "Tenant"
# darajasi). Berilmasa, `*.integration.spec.ts` testlari o'tkazib
# yuboriladi — ular hech qachon development bazasiga tegmaydi.
# Tayyorlash: prisma/README-test-db.md
DATABASE_URL_TEST=

# Sessiya (§2.7, §2.9)
SESSION_COOKIE_NAME=hisobai_session
SESSION_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Platforma (SUPERADMIN) sessiyasi — business'dan ALOHIDA cookie (§21.3)
PLATFORM_SESSION_COOKIE_NAME=hisobai_platform_session
PLATFORM_SESSION_TTL_DAYS=30

# Vaqt va jadval (§3.3, §18)
TIMEZONE=Asia/Tashkent
RATE_SYNC_HOUR=9
REMINDER_HOUR=9
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/

# §21 (6-bosqich) — seed ikkita mustaqil Shop va SHOP_ADMIN yaratadi
# (izolyatsiya testlari uchun), shuningdek bitta platforma SUPERADMIN.
# Faqat `db:seed` ishlatadi.
PLATFORM_ADMIN_EMAIL=superadmin@hisobai.uz
PLATFORM_ADMIN_PASSWORD=

ADMIN_EMAIL=admin@hisobai.uz
ADMIN_PASSWORD=
SHOP1_NAME=

SHOP2_ADMIN_EMAIL=admin2@hisobai.uz
SHOP2_ADMIN_PASSWORD=
SHOP2_NAME=

# Fayl saqlash (§0.2, 10-bosqich A). `local` — dev, disk ustida; `minio` —
# prod, S3-mos. Kalitlar faqat lokal .env yoki deploy secretda.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hisobai
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# `local` drayver uchun: saqlash papkasi va imzolangan havola kaliti
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_TOKEN_SECRET=dev-insecure-local-storage-secret
STORAGE_URL_TTL_MINUTES=15
MAX_UPLOAD_MB=10

# Web push — VAPID kalitlari repoga hech qachon kiritilmaydi
PUSH_PROVIDER=console
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Tashqi providerlar — productionda ulanadi
SMS_PROVIDER=console
MAIL_PROVIDER=console
AI_PROVIDER=none
AI_API_KEY=
