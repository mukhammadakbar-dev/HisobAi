# Bu fayl namuna. Haqiqiy qiymatlar `apps/api/.env`ga yoziladi va repoga kirmaydi.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Lokal PostgreSQL (§0.3 — development'da Docker ishlatilmaydi)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hisob_ai?schema=public"

# §21.16 — `hisobai_app` / `hisobai_migrate` DB rollari (6-bosqich, 3-qadam
# migratsiyasida yaratiladi: 20260813150000_rls_tenant_isolation_and_roles).
# Ikkalasi ham LOGIN huquqi bilan, lekin PAROLSIZ yaratiladi — operator
# `ALTER ROLE hisobai_app WITH PASSWORD '...'` (va xuddi shu tarzda
# `hisobai_migrate` uchun) bilan parol qo'yadi, keyin quyidagi ikkita
# o'zgaruvchini to'ldiradi. `DATABASE_URL` YUQORIDA hali `postgres`
# superuser'ga ishora qiladi — bu ATAYLAB: ilova qatlami (AsyncLocalStorage
# + Prisma extension) hali RLS kontekstini har so'rovga qo'ymaydi, ya'ni
# `hisobai_app` bilan ulanish barcha shop-scoped so'rovlarni bo'sh natija
# bilan qaytarardi (§21.15). Ikkala o'zgaruvchi ilova qatlami tugagach
# ishlatiladi: runtime — `hisobai_app`, `prisma migrate deploy` —
# `hisobai_migrate`. Hech biri hozircha `.env`da haqiqiy qiymat bilan
# to'ldirilmaydi.
DATABASE_URL_APP=
DATABASE_URL_MIGRATE=

# Sessiya (§2.7, §2.9)
SESSION_COOKIE_NAME=hisobai_session
SESSION_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Platforma (SUPERADMIN) sessiyasi — business'dan ALOHIDA cookie (§21.3)
PLATFORM_SESSION_COOKIE_NAME=hisobai_platform_session
PLATFORM_SESSION_TTL_DAYS=30

# Vaqt va jadval (§3.3, §18)
TIMEZONE=Asia/Tashkent
RATE_SYNC_HOUR=9
REMINDER_HOUR=9
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/

# §21 (6-bosqich) — seed ikkita mustaqil Shop va SHOP_ADMIN yaratadi
# (izolyatsiya testlari uchun), shuningdek bitta platforma SUPERADMIN.
# Faqat `db:seed` ishlatadi.
PLATFORM_ADMIN_EMAIL=superadmin@hisobai.uz
PLATFORM_ADMIN_PASSWORD=

ADMIN_EMAIL=admin@hisobai.uz
ADMIN_PASSWORD=
SHOP1_NAME=

SHOP2_ADMIN_EMAIL=admin2@hisobai.uz
SHOP2_ADMIN_PASSWORD=
SHOP2_NAME=

# Fayl saqlash — MinIO (§0.2). Kalitlar faqat lokal .env yoki deploy secretda.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hisobai
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL_TTL_MINUTES=15
MAX_UPLOAD_MB=10

# Web push — VAPID kalitlari repoga hech qachon kiritilmaydi
PUSH_PROVIDER=console
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Tashqi providerlar — productionda ulanadi
SMS_PROVIDER=console
MAIL_PROVIDER=console
AI_PROVIDER=none
AI_API_KEY=
