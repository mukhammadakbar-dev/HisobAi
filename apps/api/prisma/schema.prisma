// HisobAI CRM — ma'lumotlar modeli (v0.3 — ko'p tenantli)
//
// Manba: docs/DECISIONS.md va docs/ARCHITECTURE.md §7, §14.
// Izohlardagi §N.N — DECISIONS.md dagi qaror raqami.
// §16.N — 2026-08-09 auditidagi aniqlashtirishlar, §17.N — blocker qarorlari.
// §21.N — 2026-08-13 platforma/tenant izolyatsiyasi qarorlari (6-bosqich).
//
// QOIDALAR (ARCHITECTURE §4):
//  1. Har bir pul ustuni O'Z VALYUTA ustuni bilan yuradi. Valyutasiz summa bo'lmaydi.
//  2. Pul — Decimal(18,2). JavaScript `number` bilan pul hisoblanmaydi.
//  3. Konvertatsiya bo'lgan joyda kurs SNAPSHOT saqlanadi va qayta hisoblanmaydi.
//  4. Tasdiqlangan moliyaviy yozuv o'chirilmaydi — teskari yozuv bilan tuzatiladi.
//  5. Hisoblanadigan qiymat (qarz qoldig'i, "muddati o'tgan") saqlanmaydi.
//  6. Barcha vaqt ustunlari `timestamptz` (§17.9). "Bugun" Asia/Tashkent da
//     hisoblanadi. `@db.Date` — kalendar sana, vaqt zonasiga bog'liq emas.
//
// §21.1 — MULTI-TENANT. Platforma ikki qatlamdan iborat:
//   - PLATFORMA: `PlatformAdmin` / `PlatformSession` — `shopId` YO'Q, business
//     jadvallar bilan hech qanday aloqasi yo'q (§21.3, §25.20 invarianti —
//     kod tekshiruviga emas, strukturaga tayangan kafolat).
//   - TENANT (Shop): pastdagi deyarli barcha jadval `shopId` bilan.
// Bola jadvallarda (`sale_items`, `payment_allocations`, `stocktake_lines`,
// `payment_schedules`) `shopId` denormalizatsiya qilingan va ota bilan
// mosligi KOMPOZIT FK bilan kafolatlanadi (`@@unique([id, shopId])` ota
// ustida + `@relation(fields: [parentId, shopId], references: [id, shopId])`
// bolada) — bola qatorining `shopId` si otasinikidan farq qila olmaydi.
//
// DIQQAT: bu schema'da ifodalab bo'lmaydigan cheklovlar (CHECK, trigger,
// qisman unique index) alohida migratsiyada — `migrations/*_constraints_v0_2_1`
// va §21 migratsiyasida (IMEI triggerining shop_id bilan qayta yozilishi).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 da ulanish manzili schema'da emas — `prisma.config.ts` da
// (migratsiyalar uchun) va PrismaClient adapterida (runtime uchun) turadi.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enumlar ───────────────────────────────
// packages/contracts/src/enums.ts bilan bir xil bo'lishi shart.

enum Currency {
  UZS
  USD
}

/// §21.2 — `OWNER` dan qayta nomlangan: `OWNER` va `SHOP_ADMIN` bitta rolni
/// anglatadi, shuning uchun qo'shimcha rol emas. `SUPERADMIN` bu yerda YO'Q —
/// u `PlatformAdmin` jadvalida yashaydi (§21.3). MANAGER/SELLER hali sinovdan
/// o'tmagan — enum'ga kiritilmaydi (§16.14).
enum UserRole {
  SHOP_ADMIN
}

/// §21.6 — §25.18 (Shop status) va §25.19 (account status) birlashtirildi:
/// 1 SHOP_ADMIN = 1 SHOP modelida ikkita mustaqil status ma'nosiz kombinatsiya
/// berardi. `isActive Boolean` o'rniga: ikkita "kirish mumkinmi" manbai
/// xavfsizlik illyuziyasi (§6.12, §9.8 dagi mantiq bilan bir xil sabab).
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum ExchangeRateSource {
  CBU
  MANUAL
}

enum ProductType {
  SERIALIZED
  QUANTITY
}

/// §5.4 — "rezerv" yo'q: qoralama mahsulotni ushlab turmaydi.
/// §16.4 — RETURNED doimiy holat emas: ko'zdan kechirilgach AVAILABLE ga
/// qaytadi, `returnReason` esa saqlanib qoladi va savdo formasida belgi bo'ladi.
enum InventoryStatus {
  AVAILABLE
  SOLD
  RETURNED
  WRITTEN_OFF
}

enum StockMovementType {
  RECEIVE
  SALE
  RETURN
  ADJUST
  PERSONAL_USE
}

/// §5.7 — hisobotda sabablar ajratiladi.
enum StockAdjustReason {
  LOST
  DEFECTIVE
  MISCOUNT
  OTHER
}

enum StocktakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleKind {
  CASH
  INSTALLMENT
}

/// §17.4 — REVERSAL: qaytarish/bekor qilish teskari yozuvi. U alohida `sales`
/// qatori va yagona haqiqat manbai; asl savdodagi `returnedQuantity` va
/// PARTIALLY_RETURNED/RETURNED statuslari undan hosila kesh.
enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
  REVERSAL
}

/// §8 — bekor qilish va qaytarish qat'iy ajratiladi.
enum ReversalKind {
  RETURN
  CANCEL
}

/// §8.6 — sabab majburiy.
enum ReversalReason {
  DEFECTIVE
  CUSTOMER_CHANGED_MIND
  ENTRY_ERROR
  OTHER
}

/// §9.7 — "muddati o'tgan" holat emas (§9.8 ga qarang).
/// §17.18 — CLOSED faqat qarz to'liq to'langanda; savdo qaytarilsa yoki
/// bekor qilinsa CANCELLED.
enum ContractStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ScheduleStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

/// §10 — faqat CONFIRMED qarzni kamaytiradi va kassaga tushadi.
enum PaymentStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  REVERSED
}

enum CashAccountKind {
  CASH
  BANK
  CARD
}

enum CashDirection {
  IN
  OUT
}

/// §11.7 — MANUAL bo'lmagani qo'lda tahrirlanmaydi.
/// §11.4, §11.6 — OPENING_BALANCE va EXCHANGE daromad deb sanalmaydi.
///
/// §17.2 — `SALE` OLIB TASHLANDI: kassaga pul faqat `Payment` orqali tushadi,
///   aks holda bir pul ikki yo'ldan yozilib ikki marta sanalardi.
/// §17.12 — `PERSONAL_USE` OLIB TASHLANDI: shaxsiy foydalanishda kassadan pul
///   chiqmaydi. U pul bo'lmagan xarajat — `stock_movements` dan hisoblanadi.
enum CashSourceType {
  PAYMENT
  MANUAL
  OPENING_BALANCE
  EXCHANGE
  REVERSAL
}

enum FileKind {
  PASSPORT
  RECEIPT
  PRODUCT_IMAGE
  CASH_ATTACHMENT
  SHOP_LOGO
  CONTRACT_PDF
}

/// §15.1 — MVP'da faqat nasiya shartnomasi.
enum DocumentType {
  INSTALLMENT_CONTRACT
}

enum NotificationChannel {
  PUSH
  SMS
}

enum NotificationType {
  PAYMENT_DUE_REMINDER
}

/// PROCESSING — idempotency: xabarni faqat bitta worker oladi.
enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

// ──────────────────────── Platforma qatlami (§21.3) ────────────────────────

/// §21.3, §25.3, §25.20 — SUPERADMIN `users` jadvalida EMAS. Bu jadvalda
/// `shopId` UMUMAN YO'Q va business jadvallarga hech qanday relation yo'q —
/// shop-scoped so'rov SUPERADMIN uchun texnik jihatdan bajarilmaydi. Bu
/// kod tekshiruviga emas, strukturaga tayangan kafolat (§17.8 bilan bir xil
/// mulohaza). QASDAN qo'shimcha relation qo'shilmaydi.
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions PlatformSession[]

  @@map("platform_admins")
}

/// `Session` bilan bir xil shakl, `PlatformAdmin`ga bog'langan — alohida
/// cookie va alohida login (§21.3).
model PlatformSession {
  id              String    @id @default(uuid()) @db.Uuid
  platformAdminId String    @map("platform_admin_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  userAgent       String?   @map("user_agent")
  ip              String?
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
  @@map("platform_sessions")
}

// ──────────────────────── Shop (tenant) — §21.4 ────────────────────────

/// §21.4 — eski `settings` jadvali (id=1, bitta qator) `shops` ga aylandi:
/// do'kon ma'lumoti (§3.6) va biznes sozlamalari (§3.7–3.9, §16.2) endi har
/// Shop uchun alohida qator. Ikkita jadval (`shops` + `shop_settings`) 1:1
/// bo'lardi va har o'qishda `join` talab qilardi — ajratish uchun sabab yo'q.
///
/// §17.18 — `baseCurrency` ustuni YO'Q: bazaviy valyuta doim UZS (§1.1) va
/// `packages/contracts` dagi `BASE_CURRENCY` konstantasi yagona manba.
model Shop {
  id String @id @default(uuid()) @db.Uuid

  // §3.6 — PDF, login sahifasi va eksportlarda ishlatiladi. Eski
  // `settings.shop_name` → `shops.name` (Shop identifikatori bilan bitta maydon).
  name       String  @default("HisobAI")
  logoFileId String? @unique @map("logo_file_id") @db.Uuid
  address    String?
  phone      String?

  // §3.7 — hisobot o'rtachalari va dam olish kunida eslatma yubormaslik uchun
  workStart   String @default("09:00") @map("work_start")
  workEnd     String @default("19:00") @map("work_end")
  weekendDays Int[]  @default([0]) @map("weekend_days") // 0 = yakshanba

  // §3.8 — mahsulotga alohida chegara qo'yilmasa shu ishlatiladi
  lowStockThreshold Int @default(3) @map("low_stock_threshold")

  // §3.9 — nasiya formasida oldindan to'ldiriladi
  defaultInstallmentMonths  Int     @default(6) @map("default_installment_months")
  defaultDownPaymentPercent Decimal @default(30) @map("default_down_payment_percent") @db.Decimal(5, 2)

  /// §16.2, §14.6 — ustama FOIZ: storeRate = round(cbuRate × (1 + p/100)).
  storeRateMarkupPercent Decimal @default(0) @map("store_rate_markup_percent") @db.Decimal(5, 2)

  reminderHour Int @default(9) @map("reminder_hour")

  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logo      FileAsset? @relation("ShopLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("ShopSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  admin User? @relation("ShopAdmin")

  categories           Category[]
  brands               Brand[]
  products             Product[]
  inventoryItems       InventoryItem[]
  inventoryBatches     InventoryBatch[]
  stockMovements       StockMovement[]
  stocktakes           Stocktake[]
  stocktakeLines       StocktakeLine[]
  customers            Customer[]
  sales                Sale[]
  saleItems            SaleItem[]
  saleCounters         SaleCounter[]
  installmentContracts InstallmentContract[]
  paymentSchedules     PaymentSchedule[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  cashAccounts         CashAccount[]
  cashCategories       CashCategory[]
  cashEntries          CashEntry[]
  cashExchanges        CashExchange[]
  files                FileAsset[]           @relation("ShopFiles")
  documents            Document[]
  notificationLogs     NotificationLog[]
  pushSubscriptions    PushSubscription[]
  auditLogs            AuditLog[]
  idempotencyKeys      IdempotencyKey[]
  shopExchangeRates    ShopExchangeRate[]

  @@map("shops")
}

// ──────────────────────── Foydalanuvchilar va kirish ────────────────────────

/// §2.1 — MVP'da har Shop'da bitta foydalanuvchi (SHOP_ADMIN), lekin baza
/// ko'p rolni ko'taradi.
/// §21.10 — SHOP_ADMIN account Shop'siz yaratiladi (§25.5): `shopId`
/// NULLABLE. Shop-scoped endpointga Shop'siz kirilsa `SHOP_SETUP_REQUIRED`
/// qaytadi (servis qatlami, bu yerda emas).
model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash") // §2.4 Argon2id
  displayName  String        @map("display_name")
  role         UserRole      @default(SHOP_ADMIN)
  theme        Theme         @default(SYSTEM)
  status       AccountStatus @default(ACTIVE) @map("status")
  /// §25.7 — 1 SHOP_ADMIN = 1 SHOP.
  shopId       String?       @map("shop_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop? @relation("ShopAdmin", fields: [shopId], references: [id], onDelete: Restrict)

  sessions             Session[]
  passwordResets       PasswordResetToken[]
  pushSubscriptions    PushSubscription[]
  stockMovements       StockMovement[]
  stocktakes           Stocktake[]
  salesCreated         Sale[]
  paymentsCreated      Payment[]
  cashEntriesCreated   CashEntry[]
  filesUploaded        FileAsset[]
  shopExchangeRatesSet ShopExchangeRate[]
  shopsSettingsUpdated Shop[]               @relation("ShopSettingsUpdatedBy")
  idempotencyKeys      IdempotencyKey[]

  @@unique([shopId])
  @@map("users")
}

/// §2.7 — 30 kun; sozlamalarda faol sessiyalar ro'yxati ko'rinadi.
/// Global qoladi (§21.8 pre-verified ro'yxati): `userId` orqali istalgan
/// vaqt shop kontekstiga yetish mumkin, sessiyaning o'zi shop-scoped emas.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// §2.9 — 5 xato → 15 daqiqa blok. §2.10 — kirish jurnali.
/// `email` foreign key emas: mavjud bo'lmagan email bilan urinish ham yoziladi.
/// Global qoladi: urinish paytida email hali hech qanday Shop'ga aloqador
/// ekanligi ma'lum emas (SUPERADMIN login urinishlari ham shu yerga tushishi
/// mumkin) — §21/§25 ro'yxatlarida sanalmagan.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String?
  userAgent String?  @map("user_agent")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// §2.5 — parol tiklash email orqali.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// §17.6 — takroriy so'rovdan himoya. Telefon internetida so'rov yuborilib
/// javob yo'qolishi oddiy hol; foydalanuvchi tugmani qayta bosadi. UI'da
/// tugmani bloklash yetarli emas — so'rov allaqachon serverga yetgan bo'lishi
/// mumkin. Tafsilot: docs/API.md §4.
///
/// §21.11 — endi shop-scoped: `response_body` ustunida savdo tasdiqlash va
/// to'lov javoblari, ya'ni BOSHQA Shop'ning biznes ma'lumoti saqlanadi.
/// Kalit endi `key` emas, `(shop_id, key)` bo'yicha unique; PK esa o'z `id`
/// si (avval `key` global PK edi). Takrorlash yo'lida `request_hash` bilan
/// birga `user_id` mosligi ham tekshiriladi (servis qatlamida, §21.11).
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  key          String
  userId       String   @map("user_id") @db.Uuid
  endpoint     String
  requestHash  String   @map("request_hash")
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
  @@index([shopId, createdAt])
  @@map("idempotency_keys")
}

// ──────────────────────── Valyuta kursi (§21.5, §14.6) ────────────────────────

/// §21.5, §14.6 — eski `exchange_rates` PLATFORMA va SHOP darajasiga
/// bo'lindi. CBU kursi butun O'zbekiston uchun bitta — uni har Shop
/// qatorida takrorlash sync'ni N marta yozishga majbur qilardi.
///
/// §1.5 dagi "sync muvaffaqiyatsiz bo'lsa cbuRate null bo'lishi mumkin"
/// semantikasi shu yerda QATOR MAVJUDLIGI orqali ifodalanadi: qator faqat
/// muvaffaqiyatli sync'da yoziladi. Kunning CBU qatori yo'qligi — "bugun
/// hali sync bo'lmagan/muvaffaqiyatsiz" degani, `ShopExchangeRate` esa shu
/// kunni sanaga qarab (FK'siz, ikkalasi ham `date` bilan mustaqil) qidiradi.
model CbuRate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  rate      Decimal  @db.Decimal(12, 4)
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@map("cbu_rates")
}

/// §21.5, §14.6 — do'kon kursi: har Shop o'z ustamasi bilan hisoblaydi
/// (`Shop.storeRateMarkupPercent`, §16.2). Savdo va to'lovlarda AYNAN shu
/// ishlatiladi (§3.1). §16.6 — bugungi sana uchun qator yo'q bo'lsa, kurs
/// "eskirgan" hisoblanadi. §16.8 — `source = MANUAL` bo'lsa CBU sync
/// `storeRate`ni ustidan yozmaydi.
model ShopExchangeRate {
  id     String   @id @default(uuid()) @db.Uuid
  shopId String   @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  date   DateTime @db.Date

  storeRate Decimal            @map("store_rate") @db.Decimal(12, 4)
  source    ExchangeRateSource @default(CBU)

  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([shopId, date])
  @@map("shop_exchange_rates")
}

// ─────────────────────────────── Katalog ───────────────────────────────

/// §4.3 — dublikat oldini olish uchun `slug` normalizatsiyalangan nom.
/// §21 — `slug` endi Shop ichida unique (ikkinchi Shop birinchisining
/// slug'ini ishlatolmasligi kerak emas edi).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("brands")
}

/// Shablon. Tannarx BU YERDA saqlanmaydi (§4.1) — u ombor birligida/partiyada.
model Product {
  id         String @id @default(uuid()) @db.Uuid
  shopId     String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  brandId    String @map("brand_id") @db.Uuid

  model       String
  storage     String? // §4.7 — aksessuarlarda bo'sh
  color       String?
  /// §4.6 — brend + model + xotira + rang dan avtomatik yig'iladi
  displayName String  @map("display_name")

  type     ProductType
  /// §1.2 — mahsulotga bitta valyuta. §16.9 — ombor birligi va partiyaning
  /// `costCurrency` si shunga teng bo'lishi trigger bilan ta'minlanadi.
  currency Currency

  /// §4.2 — faqat ma'lumot uchun; qabul formasida oldindan to'ldiriladi
  suggestedPrice    Decimal? @map("suggested_price") @db.Decimal(18, 2)
  lastCostPrice     Decimal? @map("last_cost_price") @db.Decimal(18, 2)
  /// §3.8 — null bo'lsa Shop sozlamalaridagi umumiy chegara ishlatiladi
  lowStockThreshold Int?     @map("low_stock_threshold")

  description String?
  imageFileId String?  @map("image_file_id") @db.Uuid
  /// §4.8 — o'chirilmaydi, arxivlanadi
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop           Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  image          FileAsset?       @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  batches        InventoryBatch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  stocktakeLines StocktakeLine[]

  @@index([shopId, brandId, model])
  @@index([shopId, displayName])
  /// Matn qidiruvi: btree `%...%` da ishlatilmaydi, GIN + pg_trgm kerak.
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "products_display_name_trgm_idx", type: Gin)
  @@map("products")
}

// ─────────────────────────────── Ombor ───────────────────────────────

/// §5.1 — har fizik birlik alohida yozuv, O'Z tannarxi bilan.
model InventoryItem {
  id        String @id @default(uuid()) @db.Uuid
  shopId    String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// §5.3 — ikkalasi ham Shop ichida unique; qidiruv ikkala ustunni qamraydi.
  ///
  /// DIQQAT: quyidagi `@@unique` lar faqat O'Z ustuni ichida, bir Shop
  /// ichida ishlaydi. Ustunlararo takrorlanishni (A.imei_1 = B.imei_2, bir
  /// Shop ichida) esa `inventory_items_identifier_guard` trigger to'sadi —
  /// `migrations/20260810154500_imei_cross_column_unique/`, §21 da `shop_id`
  /// bilan qayta yozilgan. Trigger bir xil qiymat uchun `(shop_id, qiymat)`
  /// bo'yicha advisory lock oladi, shuning uchun parallel qabul qilishda ham
  /// poyga yo'q — va boshqa Shop'dagi qabul bunikini kutib turmaydi.
  imei1        String? @map("imei_1")
  imei2        String? @map("imei_2")
  serialNumber String? @map("serial_number")

  /// §4.1 — haqiqiy tannarx aynan shu birlikda
  costPrice    Decimal         @map("cost_price") @db.Decimal(18, 2)
  costCurrency Currency        @map("cost_currency")
  status       InventoryStatus @default(AVAILABLE)

  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  /// §8.2 — qaytgan mahsulotda sabab saqlanadi.
  /// §16.4 — status AVAILABLE ga qaytsa ham BU USTUN TOZALANMAYDI: savdo
  /// formasida "qaytarilgan mahsulot" belgisi shundan chiqadi.
  returnReason String?  @map("return_reason")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  stocktakeLines StocktakeLine[]

  @@unique([shopId, imei1])
  @@unique([shopId, imei2])
  @@unique([shopId, serialNumber])
  @@index([shopId, productId, status])
  @@map("inventory_items")
}

/// §5.2 — miqdorli mahsulot partiya bo'yicha: har partiya boshqa narxda keladi.
model InventoryBatch {
  id        String @id @default(uuid()) @db.Uuid
  shopId    String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  quantityReceived  Int      @map("quantity_received")
  /// §17.5 — kamaytirish faqat shartli UPDATE bilan:
  ///   UPDATE ... SET quantity_remaining = quantity_remaining - $n
  ///    WHERE id = $1 AND quantity_remaining >= $n
  /// Manfiy bo'lmasligi CHECK bilan ham ta'minlanadi.
  quantityRemaining Int      @map("quantity_remaining")
  unitCost          Decimal  @map("unit_cost") @db.Decimal(18, 2)
  costCurrency      Currency @map("cost_currency")

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([shopId, productId, receivedAt])
  @@map("inventory_batches")
}

/// §5.10 — har o'zgarish yoziladi va HECH QACHON o'chirilmaydi.
/// §17.12 — PERSONAL_USE va yo'qotishlar (LOST/DEFECTIVE) pul bo'lmagan
/// xarajat sifatida shu jadvaldan hisoblanadi; kassaga tegmaydi.
model StockMovement {
  id              String  @id @default(uuid()) @db.Uuid
  shopId          String  @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  batchId         String? @map("batch_id") @db.Uuid

  type     StockMovementType
  /// Seriyalida har doim 1; miqdorlida partiyadan olingan miqdor.
  quantity Int
  reason   StockAdjustReason?

  /// Qaysi hujjat sabab bo'ldi: SALE / STOCKTAKE / RECEIVE va h.k.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  batch         InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor         User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shopId, productId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([inventoryItemId, occurredAt])
  @@index([shopId, type, occurredAt])
  @@map("stock_movements")
}

/// §5.6 — jismonan sanab, tizimdagi qoldiq bilan solishtirish.
model Stocktake {
  id          String          @id @default(uuid()) @db.Uuid
  shopId      String          @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  status      StocktakeStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(3)
  actorId     String?         @map("actor_id") @db.Uuid
  note        String?

  shop  Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  lines StocktakeLine[]

  @@unique([id, shopId])
  @@index([shopId])
  @@map("stocktakes")
}

model StocktakeLine {
  id              String  @id @default(uuid()) @db.Uuid
  shopId          String  @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  stocktakeId     String  @map("stocktake_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  /// Seriyali mahsulotda aniq birlik ko'rsatiladi.
  inventoryItemId String? @map("inventory_item_id") @db.Uuid

  expectedQuantity Int                @map("expected_quantity")
  countedQuantity  Int                @map("counted_quantity")
  reason           StockAdjustReason?
  note             String?

  /// §21 — kompozit FK: bu qatorning `shopId` si `stocktake`nikidan
  /// farq qila olmaydi (parent `@@unique([id, shopId])` ustiga qurilgan).
  stocktake     Stocktake      @relation(fields: [stocktakeId, shopId], references: [id, shopId], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  shop          Shop           @relation(fields: [shopId], references: [id])

  @@index([shopId, stocktakeId])
  @@map("stocktake_lines")
}

// ─────────────────────────────── Mijozlar ───────────────────────────────

/// Qarz ustuni YO'Q — qarz faqat tranzaksiyalardan hisoblanadi (§6.12).
/// §21, §25.15 — Customer global entity emas: Shop A va Shop B da bir xil
/// telefon raqami ikkita mustaqil mijoz.
model Customer {
  id       String @id @default(uuid()) @db.Uuid
  shopId   String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  fullName String @map("full_name")

  /// §6.2, §6.4 — E.164, Shop ichida unique; SMS shunga ketadi
  phonePrimary   String  @map("phone_primary")
  phoneSecondary String? @map("phone_secondary")

  address String?
  note    String?

  // §6.5 — nasiya shartnomasi PDF'ida chiqadi (§16.10)
  passportSeries String? @map("passport_series")
  passportNumber String? @map("passport_number")
  pinfl          String?
  passportFileId String? @unique @map("passport_file_id") @db.Uuid

  /// §6.9 — ogohlantiradi, lekin taqiqlamaydi
  isFlagged  Boolean @default(false) @map("is_flagged")
  flagReason String? @map("flag_reason")

  /// §6.13 — savdosi bor mijoz o'chirilmaydi
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  passportFile     FileAsset?        @relation(fields: [passportFileId], references: [id], onDelete: SetNull)
  sales            Sale[]
  notificationLogs NotificationLog[]

  @@unique([shopId, phonePrimary])
  @@index([shopId, fullName])
  @@index([shopId, phoneSecondary])
  /// Matn qidiruvi (§6.4 — ism bo'yicha qidiriladi).
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "customers_full_name_trgm_idx", type: Gin)
  @@map("customers")
}

// ─────────────────────────────── Savdo ───────────────────────────────

/// §17.1 — savdo raqami QORALAMADA YO'Q: u tasdiqlash tranzaksiyasi ichida
/// `sale_counters` dan ajratiladi. Shu sabab o'chirilgan qoralama raqam
/// teshigi qoldirmaydi.
model Sale {
  id     String  @id @default(uuid()) @db.Uuid
  shopId String  @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  /// §7.6 — yil + ketma-ket raqam, masalan `2026-00147`.
  /// Teskari yozuvda: `2026-00147-R1` (§17.4).
  /// §21.9 — endi Shop ichida unique (umumiy bo'lsa ikkinchi Shop raqami
  /// birinchisining savdo hajmini oshkor qilardi).
  number String?

  customerId String?    @map("customer_id") @db.Uuid // §6.1 — naqdda ixtiyoriy
  kind       SaleKind
  status     SaleStatus @default(DRAFT)

  /// §1.9, §16.1 — bitta savdo, bitta valyuta; foydalanuvchi aniq tanlaydi
  currency     Currency
  /// §1.7 — kurs snapshot; qaytarishda ham AYNAN shu ishlatiladi (§1.8).
  /// §17.11 — savdo SANASIDAGI Shop kursi olinadi (orqaga qo'yilganda ham).
  /// Tasdiqlash paytida yoziladi, qoralamada emas (§16.1).
  exchangeRate Decimal  @map("exchange_rate") @db.Decimal(12, 4)

  /// §7.3 — alohida chegirma maydoni yo'q; narx qatorda o'zgartiriladi.
  /// §17.3 — nasiyada ham NAQD NARXLAR yig'indisi; ustama shartnomada.
  /// §17.18 — `subtotal` ustuni yo'q: u doim `total` ga teng edi.
  total Decimal @db.Decimal(18, 2)

  /// §7.5 — 7 kungacha orqaga qo'yish mumkin
  soldAt      DateTime  @map("sold_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  createdById String? @map("created_by_id") @db.Uuid

  // §8, §17.4 — teskari yozuv alohida qator va yagona haqiqat manbai.
  // Qaytarish o'z sanasiga (§8.7), bekor qilish asl savdo sanasiga (§16.5).
  reversesSaleId String?         @map("reverses_sale_id") @db.Uuid
  reversalKind   ReversalKind?   @map("reversal_kind")
  reversalReason ReversalReason? @map("reversal_reason")
  reversalNote   String?         @map("reversal_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reversesSale Sale?                @relation("SaleReversal", fields: [reversesSaleId], references: [id], onDelete: Restrict)
  reversals    Sale[]               @relation("SaleReversal")
  items        SaleItem[]
  contract     InstallmentContract?
  payments     Payment[]

  @@unique([id, shopId])
  @@unique([shopId, number])
  @@index([shopId, status, soldAt])
  @@index([shopId, customerId, soldAt])
  @@index([shopId, reversesSaleId])
  @@map("sales")
}

/// §17.1, §21.9 — savdo raqamini poygasiz ajratish, Shop bo'yicha mustaqil
/// hisoblagich: PK `(shop_id, year)`.
///   INSERT INTO sale_counters(shop_id, year) VALUES ($1, $2) ON CONFLICT DO NOTHING;
///   UPDATE sale_counters SET last_seq = last_seq + 1 WHERE shop_id = $1 AND year = $2
///     RETURNING last_seq;   -- qator qulfi poygani hal qiladi
model SaleCounter {
  shopId  String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  year    Int
  lastSeq Int    @default(0) @map("last_seq")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@id([shopId, year])
  @@map("sale_counters")
}

/// §7.11 — snapshotlar: keyingi narx o'zgarishi eski foydani o'zgartirmaydi.
model SaleItem {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  saleId String @map("sale_id") @db.Uuid

  productId       String  @map("product_id") @db.Uuid
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  batchId         String? @map("batch_id") @db.Uuid

  quantity  Int     @default(1)
  /// Savdo valyutasida. Boshqa valyutali mahsulot savdo kursida aylantiriladi (§1.9).
  /// §17.3 — nasiyada ham NAQD NARX (ustamasiz).
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)

  /// §7.11 — tannarx snapshot, o'z valyutasi bilan
  costSnapshot Decimal  @map("cost_snapshot") @db.Decimal(18, 2)
  costCurrency Currency @map("cost_currency")

  /// §7.4 — chegirma hisoboti = tavsiya narx − haqiqiy narx
  suggestedPriceSnapshot Decimal? @map("suggested_price_snapshot") @db.Decimal(18, 2)

  /// §8.4 — qisman qaytarish.
  /// §17.4 — bu KESH: haqiqat manbai teskari `sales` qatorlari. Faqat
  /// qaytarish tranzaksiyasi ichida yangilanadi.
  returnedQuantity Int @default(0) @map("returned_quantity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// §21 — kompozit FK: `shopId` `sale`nikidan farq qila olmaydi.
  sale          Sale            @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  batch         InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  shop          Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId, saleId])
  @@index([shopId, productId])
  @@index([shopId, inventoryItemId])
  @@map("sale_items")
}

// ─────────────────────────────── Nasiya ───────────────────────────────

/// `outstanding` ustuni YO'Q — jadval va taqsimotlardan hisoblanadi.
model InstallmentContract {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  saleId String @unique @map("sale_id") @db.Uuid

  /// §9.2 — savdo valyutasi, o'zgarmaydi
  currency Currency

  /// §9.3, §17.3 — naqd narx + ustama (summa yoki foiz).
  /// `cashPrice` = `sales.total`. Ustama hisobotda ALOHIDA daromad satri
  /// bo'ladi (§9.4) va yalpi foydaga qo'shilmaydi.
  cashPrice     Decimal  @map("cash_price") @db.Decimal(18, 2)
  markupAmount  Decimal  @default(0) @map("markup_amount") @db.Decimal(18, 2)
  markupPercent Decimal? @map("markup_percent") @db.Decimal(5, 2)

  /// principal = cashPrice + markupAmount − downPayment (CHECK bilan)
  principal   Decimal @db.Decimal(18, 2)
  /// §16.3 — 0 bo'lishi mumkin: ogohlantiradi, taqiqlamaydi
  downPayment Decimal @default(0) @map("down_payment") @db.Decimal(18, 2)

  /// §17.18 — CLOSED faqat qarz to'liq to'langanda; qaytarish/bekor qilishda
  /// CANCELLED.
  status   ContractStatus @default(ACTIVE)
  closedAt DateTime?      @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  /// §21 — `saleId` allaqachon shop-scoped `sales`ga 1:1 bog'langan
  /// (pre-verified ro'yxat), shuning uchun bu yerda kompozit FK shart emas.
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  schedules PaymentSchedule[]
  payments  Payment[]
  documents Document[]

  @@unique([id, shopId])
  @@index([shopId, status])
  @@map("installment_contracts")
}

/// §9.6 — jadval summasi qarzga teng bo'lishi shart; yaxlitlash qoldig'i
/// OXIRGI qatorga qo'shiladi (§17.15). Oyning kuni keyingi oyda bo'lmasa
/// (31 → fevral), o'sha oyning oxirgi kuni olinadi (§17.15).
/// §9.8 — "muddati o'tgan" saqlanmaydi: `dueDate < bugun` va qarz qolganidan
/// hisoblanadi.
model PaymentSchedule {
  id         String @id @default(uuid()) @db.Uuid
  shopId     String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  sequence   Int
  dueDate    DateTime       @map("due_date") @db.Date
  amountDue  Decimal        @map("amount_due") @db.Decimal(18, 2)
  /// §17.4 bilan bir mantiq — bu KESH: haqiqat manbai `payment_allocations`.
  /// Faqat to'lov tranzaksiyasi ichida yangilanadi.
  amountPaid Decimal        @default(0) @map("amount_paid") @db.Decimal(18, 2)
  status     ScheduleStatus @default(UNPAID)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop             Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  /// §21 — kompozit FK: `shopId` `contract`nikidan farq qila olmaydi.
  contract         InstallmentContract @relation(fields: [contractId, shopId], references: [id, shopId], onDelete: Cascade)
  allocations      PaymentAllocation[]
  notificationLogs NotificationLog[]

  @@unique([contractId, sequence])
  @@index([shopId, dueDate, status])
  @@map("payment_schedules")
}

// ─────────────────────────────── To'lovlar ───────────────────────────────

/// §7.2 — savdoga ham, shartnomaga ham bog'lana oladi.
/// v0.1 da faqat `contractId` bor edi va naqd savdo to'lovini yozadigan joy yo'q edi.
/// §17.2 — kassaga pul AYNAN shu jadval orqali tushadi; savdo to'g'ridan-to'g'ri
/// `cash_entries` yaratmaydi.
model Payment {
  id         String  @id @default(uuid()) @db.Uuid
  shopId     String  @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  saleId     String? @map("sale_id") @db.Uuid
  contractId String? @map("contract_id") @db.Uuid

  /// §10 — haqiqatda berilgan summa va uning valyutasi
  paidAmount      Decimal  @map("paid_amount") @db.Decimal(18, 2)
  paidCurrency    Currency @map("paid_currency")
  /// §1.7, §17.11 — to'lov SANASIDAGI Shop kursi
  exchangeRate    Decimal  @map("exchange_rate") @db.Decimal(12, 4)
  /// §10.5 — qarzdan qancha ayrildi, shartnoma valyutasida.
  /// §16.11 — qarz qoldig'idan OSHMAYDI: ortiqcha to'lov umuman kiritilmaydi.
  appliedAmount   Decimal  @map("applied_amount") @db.Decimal(18, 2)
  appliedCurrency Currency @map("applied_currency")

  method PaymentMethod
  status PaymentStatus @default(PENDING_VERIFICATION)

  /// §10.4 — 7 kungacha orqaga qo'yish mumkin
  paidAt         DateTime  @map("paid_at") @db.Timestamptz(3)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  rejectedReason String?   @map("rejected_reason")

  /// §10.3 — ixtiyoriy
  receiptFileId String? @unique @map("receipt_file_id") @db.Uuid
  /// §11.1 — pul qaysi hisobga tushdi
  cashAccountId String? @map("cash_account_id") @db.Uuid
  createdById   String? @map("created_by_id") @db.Uuid

  /// §10.6 — qaytarish teskari yozuv sifatida
  reversesPaymentId String? @map("reverses_payment_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale            Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  contract        InstallmentContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  receiptFile     FileAsset?           @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  cashAccount     CashAccount?         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reversesPayment Payment?             @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversals       Payment[]            @relation("PaymentReversal")
  allocations     PaymentAllocation[]
  cashEntries     CashEntry[]

  @@unique([id, shopId])
  @@index([shopId, saleId, status])
  @@index([shopId, contractId, status])
  @@index([shopId, status, paidAt])
  @@index([shopId, cashAccountId, paidAt])
  @@map("payments")
}

/// §10.1 — eng eski to'lanmagan qatordan boshlab taqsimlanadi.
/// Alohida jadval: qaytarishni aniq teskari bajarish uchun kerak.
model PaymentAllocation {
  id         String  @id @default(uuid()) @db.Uuid
  shopId     String  @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  paymentId  String  @map("payment_id") @db.Uuid
  scheduleId String  @map("schedule_id") @db.Uuid
  amount     Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// §21 — kompozit FK: `shopId` `payment`nikidan farq qila olmaydi.
  payment  Payment         @relation(fields: [paymentId, shopId], references: [id, shopId], onDelete: Cascade)
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  shop     Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId, paymentId])
  @@index([shopId, scheduleId])
  @@map("payment_allocations")
}

// ─────────────────────────────── Kassa ───────────────────────────────

/// §11.1, §11.3 — karta puli kassa yashigida yo'q, shuning uchun hisoblar ajratiladi.
model CashAccount {
  id        String          @id @default(uuid()) @db.Uuid
  shopId    String          @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  name      String
  currency  Currency
  kind      CashAccountKind
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  entries       CashEntry[]
  payments      Payment[]
  exchangesFrom CashExchange[] @relation("ExchangeFrom")
  exchangesTo   CashExchange[] @relation("ExchangeTo")

  @@unique([shopId, name, currency])
  @@index([shopId])
  @@map("cash_accounts")
}

/// §11.10 — tizim kategoriyalari o'chirilmaydi; yangisini qo'shish mumkin.
model CashCategory {
  id        String         @id @default(uuid()) @db.Uuid
  shopId    String         @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  name      String
  slug      String
  direction CashDirection?
  isSystem  Boolean        @default(false) @map("is_system")
  isActive  Boolean        @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  entries CashEntry[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("cash_categories")
}

/// §17.2 — `saleId` ustuni YO'Q: savdo kassaga to'g'ridan-to'g'ri yozmaydi.
/// Bog'lanish `cash_entry → payment → sale` orqali.
model CashEntry {
  id        String        @id @default(uuid()) @db.Uuid
  shopId    String        @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  direction CashDirection
  amount    Decimal       @db.Decimal(18, 2)
  /// Hisob valyutasi bilan bir xil bo'lishi shart (trigger bilan ta'minlanadi).
  currency  Currency

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  categoryId String?  @map("category_id") @db.Uuid

  /// §11.7 — MANUAL bo'lmagani qo'lda tahrirlanmaydi
  sourceType CashSourceType @map("source_type")
  sourceId   String?        @map("source_id") @db.Uuid
  paymentId  String?        @map("payment_id") @db.Uuid

  note             String?
  attachmentFileId String? @unique @map("attachment_file_id") @db.Uuid
  createdById      String? @map("created_by_id") @db.Uuid

  /// §11.8 — ertasiga tuzatish faqat teskari yozuv bilan
  reversesEntryId String? @map("reverses_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  account       CashAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      CashCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attachment    FileAsset?    @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reversesEntry CashEntry?    @relation("CashEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversals     CashEntry[]   @relation("CashEntryReversal")

  @@index([shopId, accountId, occurredAt])
  @@index([shopId, sourceType, sourceId])
  @@index([shopId, occurredAt])
  @@index([shopId, paymentId])
  @@map("cash_entries")
}

/// §11.6 — ayirboshlash alohida amal; daromad deb sanalmaydi.
/// Ikkita `cash_entries` yozuvi bilan birga yaratiladi.
model CashExchange {
  id            String @id @default(uuid()) @db.Uuid
  shopId        String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  fromAccountId String @map("from_account_id") @db.Uuid
  toAccountId   String @map("to_account_id") @db.Uuid

  fromAmount Decimal @map("from_amount") @db.Decimal(18, 2)
  toAmount   Decimal @map("to_amount") @db.Decimal(18, 2)
  rate       Decimal @db.Decimal(12, 4)

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  fromAccount CashAccount @relation("ExchangeFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   CashAccount @relation("ExchangeTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([shopId, occurredAt])
  @@map("cash_exchanges")
}

// ──────────────────── Fayllar, hujjatlar, bildirishnomalar ────────────────────

/// §15.5 — hech qachon ochiq havolada bo'lmaydi. §15.7 — 10 MB, siqilmaydi.
/// Yuklashda MIME oq ro'yxati, fayl imzosi va EXIF tozalash (docs/API.md §7).
/// `storageKey` global qoladi (pre-verified ro'yxat): u ilova tomonidan
/// yaratilgan uuid, tenant bilan bog'liq emas.
model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  kind         FileKind
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop          Shop        @relation("ShopFiles", fields: [shopId], references: [id], onDelete: Restrict)
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  shopsWithLogo Shop[]      @relation("ShopLogo")
  products      Product[]
  customers     Customer[]
  payments      Payment[]
  cashEntries   CashEntry[]
  documents     Document[]

  @@index([shopId])
  @@map("files")
}

/// §15.2, §15.3 — har qayta tuzishda yangi versiya; eskisi ham qoladi.
/// §16.10 — nasiya bosqichi uchun majburiy.
model Document {
  id         String       @id @default(uuid()) @db.Uuid
  shopId     String       @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  type       DocumentType @default(INSTALLMENT_CONTRACT)
  contractId String       @map("contract_id") @db.Uuid
  version    Int          @default(1)
  fileId     String       @map("file_id") @db.Uuid

  contentHash String?  @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop     Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  contract InstallmentContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  file     FileAsset           @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([contractId, version])
  @@index([shopId])
  @@map("documents")
}

model NotificationLog {
  id      String              @id @default(uuid()) @db.Uuid
  shopId  String              @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  channel NotificationChannel
  type    NotificationType

  /// Push uchun endpoint, SMS uchun telefon raqami.
  recipient  String
  /// §17.13 — majburiy: nullable bo'lsa unique kaliti ishlamas edi
  /// (PostgreSQL'da NULL dublikatga to'sqinlik qilmaydi).
  scheduleId String  @map("schedule_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  status              NotificationStatus @default(PENDING)
  scheduledFor        DateTime           @map("scheduled_for") @db.Timestamptz(3)
  sentAt              DateTime?          @map("sent_at") @db.Timestamptz(3)
  /// 10 daqiqadan ortiq turib qolgan ishlov qayta uriniladi.
  processingStartedAt DateTime?          @map("processing_started_at") @db.Timestamptz(3)
  error               String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// §17.13 — `scheduledFor` kalitga KIRADI: jadval qatori qayta
  /// rejalashtirilganda (§9.10) yangi sana uchun eslatma yuborilsin.
  @@unique([scheduleId, channel, type, scheduledFor])
  @@index([shopId, status, scheduledFor])
  @@map("notification_logs")
}

/// §21.12, §25.10 — shop-scoped: eslatma jarayoni (§10) obunani
/// `payment_schedules` orqali topadi, foydalanuvchi orqali emas. Shop
/// kontekstisiz bir do'konning to'lov eslatmasi boshqasining qurilmasiga
/// yuborilishi mumkin edi — xabarda mijoz ismi va summa bor (§18).
model PushSubscription {
  id       String @id @default(uuid()) @db.Uuid
  shopId   String @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  endpoint String @unique
  p256dh   String
  auth     String

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, userId])
  @@map("push_subscriptions")
}

/// §2.2 — har amal qaysi foydalanuvchi qilganini yozadi.
/// §6.7 — passport rasmini kim ko'rgani ham shu yerga tushadi.
/// Ilova DB roli uchun UPDATE/DELETE rad etiladi (docs/PERMISSIONS.md §4) —
/// "o'zgarmas audit" e'lon emas, kafolat bo'lsin.
///
/// `shopId` NULLABLE: bu jadval shop-scoped business amallar UCHUN, lekin
/// §25.17 SUPERADMIN'ning account-level amallarini (SHOP_ADMIN_CREATED va
/// h.k.) ham shu yerga yozishni talab qiladi — bunday amal SHOP_ADMIN
/// hali Shop yaratmagan bosqichda sodir bo'ladi (§21.10), ya'ni `shopId`
/// hali mavjud emas. Business yozuvlarda har doim to'ldiriladi.
///
/// `actorId` — QASDAN FK RELATSIYASIZ (6-bosqichda `User`ga bog'langan
/// `@relation` olib tashlandi). Sabab: audit yozuvini ikki xil aktyor
/// yozadi — biznes `User` (`shopId` bilan) VA platforma `PlatformAdmin`
/// (§25.17, SHOP_ADMIN_CREATED va h.k.). `PlatformAdmin` esa §21.3
/// bo'yicha business jadvallarga HECH QANDAY relation olmasligi shart —
/// aks holda SUPERADMIN'ning "tenant data'ga structural jihatdan kira
/// olmasligi" invarianti (§25.20) FK orqali teshilardi. Ikkala aktyor turi
/// bitta ustunga bitta xil kalit fazosida (UUID) yozilishi mumkin emas va
/// FK bitta jadvalga bog'lanishi shart bo'lgani uchun — `actorId` ataylab
/// oddiy (indekslangan, lekin bog'lanmagan) ustun sifatida qoladi. Audit
/// o'zgarmas (`PERMISSIONS.md` §4) va yozuvlar hech qachon join qilinmaydi
/// (hozircha `GET /audit` yo'q) — FK yo'qligi amaliy xavf tug'dirmaydi.
model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  shopId     String? @default(dbgenerated("(NULLIF(current_setting('app.current_shop_id'::text, true), ''::text))::uuid")) @map("shop_id") @db.Uuid
  actorId    String? @map("actor_id") @db.Uuid
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, entityType, entityId])
  @@index([shopId, actorId, createdAt])
  @@index([shopId, createdAt])
  @@index([shopId, action, createdAt])
  @@map("audit_logs")
}
