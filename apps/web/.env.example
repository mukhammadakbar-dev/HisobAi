# Brauzerdan ko'rinadigan API manzili.
#
# Bo'sh qoldiring — standart `/api/v1` (nisbiy). Shunda so'rov web bilan
# bir xil origin'ga ketadi va `next.config.ts` uni API'ga proksilaydi:
# telefon LAN IP orqali kirganda ham ishlaydi va CORS ishtirok etmaydi.
#
# Bu yerga `http://localhost:4000/api/v1` yozilsa, telefon O'Z `localhost`iga
# uradi va hamma so'rov yiqiladi.
#
# Alohida domenda: https://api.example.uz/api/v1
NEXT_PUBLIC_API_URL=

# Dev proksining nishoni. API boshqa portda yoki hostda bo'lsagina o'zgartiring.
# API_PROXY_ORIGIN=http://localhost:4000

# Web push public kaliti (private kalit faqat API tomonda turadi)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
